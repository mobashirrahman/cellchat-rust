^\.rlib$
^\.git$
^\.cargo$
^Cargo\.toml$
^Cargo\.lock$
^_pkgdown\.yml$
^paper$
^scripts$
^r-build$
^upstream$
^data/(humanSkin\.rda|wound\.rda|visium\.rds)$
# `tests/parity`: 470 KB of oracle generators and differential gates. They need the pinned
# upstream tree at run time and `R CMD check` never runs them -- `check-contract-inputs.R` and
# friends are driven by `tests/parity/*.R` from CI, not by the package's own test targets, which
# are the four `tests/test-*.R`. They stay in the repository, which is where the audit trail
# lives.
^tests/parity$
^target$
^src/rust/r-build/target$
^stdout$
^\.\.Rcheck$
^bench-runner$
^docs$
^\.github$
^parity\.json$
^UPSTREAM\.md$
^PLAN\.md$
# Built by ./configure from src/rust/crates/; shipping it would ship a stale binary and `R CMD check`
# warns about object files in a source package.
^src/CellChat\.so$
# The Rust test targets read the golden corpora by relative path, so the fixtures and the
# parity generators travel with them. `tests/parity/*.R` are the oracle generators and the
# installed-shim differential gate; they need the pinned upstream tree at run time and are
# therefore not run by `R CMD check`, but they are part of what makes the claim auditable.
^tests/parity/check_identical\.R$
^\.gitkeep$
\.gitkeep$
# `R CMD build` output. It is gitignored but that is not enough: `R CMD build` does not read
# `.gitignore`, so a tarball left in the source directory by an earlier build gets packaged into
# the next one. A stale `cellchatrs_0.1.0.tar.gz` was 5.7 MB of the 13.8 MB tarball -- the single
# largest item, and a recursively nested copy of the package. Name-agnostic on purpose: the
# package was renamed from `cellchatrs` to `CellChat`, and a pattern naming either one silently
# stops matching the day that changes.
^[^/]*_[0-9][^/]*\.tar\.gz$

# `tests/fixtures` in its entirety, not just its largest members. These are `cargo test` inputs read
# by relative path from a repository checkout; nothing in the installed R package or in
# `R CMD check`'s only test target (`tests/test-package.R`) reads them. They stay in the repository
# because they are what makes the bit-identity claim auditable, and
# `scripts/gen_fixtures.sh` regenerates them from the pinned upstream. Shipping them cost ~1 MB
# compressed, which is the difference between a source tarball under CRAN's 5 MB limit and over it.
^tests/fixtures$
